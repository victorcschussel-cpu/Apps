# Conta de SEGUIDOR do LibreLinkUp (não a do app LibreLink)
LLU_EMAIL=
LLU_PASSWORD=
# Versão do app enviada no header; a API recusa versões antigas
LLU_VERSION=4.16.0
# Opcional: "Nome Sobrenome" do paciente, se a conta seguir mais de um
LLU_PATIENT_NAME=
SYNC_INTERVAL_MIN=90

# Acesso ao app
APP_PASSWORD=
# >= 32 caracteres aleatórios: openssl rand -hex 32
SESSION_SECRET=

TZ_DISPLAY=America/Sao_Paulo
DB_PATH=./data/glicemia.db
PORT=8080
